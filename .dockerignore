# Ignore dependencies (to force fresh install inside Docker)
node_modules
npm-debug.log
yarn-error.log

# Ignore unnecessary build artifacts
dist
build

# Ignore local environment files
.env
.env.local
.env.production
.env.development

# Ignore version control and editor settings
.git
.gitignore
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Do NOT ignore these (needed inside Docker)
!package.json
!package-lock.json
